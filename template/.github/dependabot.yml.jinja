# Dependabot version updates. Project-owned: the template renders only the
# core's github-actions block; a pack or the project adds its own ecosystems
# here, because Dependabot reads this one file
# (https://github.com/brunoccalmeida/automation-template/blob/main/docs/adr/0012-github-files-rendered-by-the-core.md).
# Security updates are enabled by .github/scripts/apply-github-settings.sh
# (/new-project) and ignore the cooldown, which applies to version updates only
# (Dependabot options reference, cooldown).
#
# Cooldown: a compromised or broken release is usually taken down within
# days, so version updates wait 7 days; zizmor's dependabot-cooldown audit
# (core-checks.yml, workflow-audit) flags fewer.
version: 2
updates:
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    cooldown:
      default-days: 7
    commit-message:
      prefix: "ci"
      include: "scope"
    groups:
      # Low risk and reviewed together: one PR for all actions
      github-actions:
        patterns: ["*"]
{%- if pack == 'ts-playwright' %}

  # The pack's dependencies, pinned exactly in package.json: bump the pin,
  # never widen it. Majors match no group and get a PR of their own: a major
  # is a human decision (release notes, peer dependencies)
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"
    versioning-strategy: "increase"
    cooldown:
      default-days: 7
    open-pull-requests-limit: 5
    commit-message:
      prefix: "build"
      include: "scope"
    groups:
      npm-minor-patch:
        patterns: ["*"]
        update-types: ["minor", "patch"]
    ignore:
      # typescript-eslint's peer dependency rejects the next TypeScript major,
      # so its PR would fail `npm ci` (ERESOLVE). A Dependabot ignore is
      # silent: scripts/check-dependency-ignores.ts fails `npm run check` once
      # typescript-eslint accepts that major; then delete this entry in a PR
      # of its own (see the script for the steps)
      - dependency-name: "typescript"
        update-types: ["version-update:semver-major"]
{%- endif %}

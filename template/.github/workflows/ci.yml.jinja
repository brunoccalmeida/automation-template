name: CI

# Project-owned: rendered once by the template, then the project adds its own
# jobs here and to the needs of the gate (ADR 0012). The core's checks come
# from core-checks.yml, which the template updates (ADR 0011).
on:
  pull_request:
  push:
    branches: [{{ main_branch }}]

# Least privilege: the jobs only read the repository
permissions:
  contents: read

# A new push to a PR supersedes the run of the previous commit; runs on the
# main branch are never cancelled
concurrency:
{%- raw %}
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
{%- endraw %}

jobs:
  # The core's enforcement (UTF-8 text, secret scan, workflow audit). A
  # called workflow's job succeeds only when all of its jobs do. $/: this
  # repository at the running commit, with no checkout (GitHub Docs,
  # "Workflow syntax", uses); zizmor flags "./" (self-repository)
  core-checks:
    uses: $/.github/workflows/core-checks.yml
    permissions:
      contents: read
{%- if pack == 'ts-playwright' %}

  # Contract `check`: type check, lint and format check
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout code
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # The same Node as local development: one source (.node-version)
      - name: Set up Node
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .node-version
          cache: npm

      # ci, not install: fails if package-lock.json and package.json disagree
      - name: Install dependencies
        run: npm ci

      - name: Type check, lint and format check
        run: npm run check

  # Contract `test`: the whole suite, smoke included, against BASE_URL. Set
  # the BASE_URL variable in the repository settings (Actions variables, not
  # secrets: a URL is not a secret); without it the suite stops at startup
  # naming the variable (src/config/env.ts)
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout code
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Set up Node
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .node-version
          cache: npm

      - name: Install dependencies
        run: npm ci
{%- if 'e2e' in test_types %}

      # The browser and its system libraries, Chromium only (playwright.dev,
      # "Continuous Integration" and "Browsers"); the version comes from the
      # installed @playwright/test, so it never drifts from the lockfile
      - name: Install Chromium
        run: npx playwright install --with-deps chromium
{%- endif %}

      - name: Run the tests
        run: npm test
        env:
{%- raw %}
          BASE_URL: ${{ vars.BASE_URL }}
{%- endraw %}
{%- endif %}

  # The single required check of the ruleset (contract `gate`,
  # .github/rulesets/protect-main.json). Requiring each job by name would
  # mean editing the ruleset whenever a job is added or renamed; this job's
  # name never changes. always(): a required check that is skipped counts as
  # passed, so the gate must run, and fail, when a dependency fails or is
  # cancelled (GitHub Docs, "Troubleshooting required status checks").
  {{ gate }}:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    needs: [core-checks{% if pack == 'ts-playwright' %}, check, test{% endif %}]
{%- raw %}
    if: ${{ always() }}
{%- endraw %}

    steps:
      - name: Checkout code
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # A job missing from "needs" would not gate the merge. Compare the
      # jobs this gate waited for with every other job of this workflow.
      - name: Require the gate to need every job
        env:
{%- raw %}
          NEEDS: ${{ toJSON(needs) }}
{%- endraw %}
        run: |
          expected=$(yq -o=json '.jobs | keys | map(select(. != "{{ gate }}")) | sort' .github/workflows/ci.yml | jq -c .)
          actual=$(jq -c 'keys | sort' <<< "$NEEDS")
          echo "workflow jobs: $expected"
          echo "gate needs:    $actual"
          test "$expected" = "$actual"

      # Allowlist: only an explicit "success" passes; failure, cancelled and
      # skipped all fail, because a skipped job tested nothing.
      - name: Require every job to succeed
        env:
{%- raw %}
          NEEDS: ${{ toJSON(needs) }}
{%- endraw %}
        run: |
          jq -r 'to_entries[] | "\(.key): \(.value.result)"' <<< "$NEEDS"
          jq -e 'length > 0 and all(.[]; .result == "success")' <<< "$NEEDS" > /dev/null
